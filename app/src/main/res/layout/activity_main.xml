<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header Studio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SmartClipper AI"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Klip Reels &amp; Shorts 1080p HD + Auto Subtitle"
                    android:textColor="#8E9BB5"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="1080P HD"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Kotak Pilih Video -->
        <LinearLayout
            android:id="@+id/cardVideoPicker"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/bg_card_modern"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill_accent"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Pilih Video Panjang dari Galeri"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mendukung MP4, MKV, MOV hingga resolusi tinggi"
                android:textColor="#7D8BA5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Kotak Preview Video -->
        <LinearLayout
            android:id="@+id/cardVideoPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_modern"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="#000000">

                <VideoView
                    android:id="@+id/videoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVideoInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Video terpilih"
                    android:textColor="#D5DFEE"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnChangeVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:text="Ganti Video"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Panel Pengaturan Clipper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_modern"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Mode Pemotongan Pintar"
                android:textColor="#A7B5CE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbSmartHighlight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#00E5FF"
                    android:checked="true"
                    android:text="Auto Highlight (Cari momen audio paling seru)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbSequential"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#00E5FF"
                    android:text="Potong Berurutan (Part 1, Part 2, Part 3...)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="2. Durasi Per Klip"
                android:textColor="#A7B5CE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb15s"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#6C5CE7"
                    android:text="15d"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb30s"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#6C5CE7"
                    android:checked="true"
                    android:text="30d"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb45s"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#6C5CE7"
                    android:text="45d"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb60s"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#6C5CE7"
                    android:text="60d"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="3. Format Layar Vertikal (1080x1920 HD)"
                android:textColor="#A7B5CE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgRatio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCrop916"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#00E5FF"
                    android:checked="true"
                    android:text="Full Crop 9:16"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbFit916"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#00E5FF"
                    android:text="Fit Utuh 9:16"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </RadioGroup>

            <!-- Sakelar Subtitle Otomatis -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subtitle Otomatis (AI)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubtitleHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tempel teks ucapan otomatis di video"
                        android:textColor="#8E9BB5"
                        android:textSize="11sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tombol Utama Analisa -->
        <TextView
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_accent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Analisa &amp; Buat Daftar Scene"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Indikator Proses -->
        <LinearLayout
            android:id="@+id/layoutProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_modern"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvProgressStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Memproses video..."
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:progressTint="#00E5FF" />
        </LinearLayout>

        <!-- Header Hasil Scene -->
        <LinearLayout
            android:id="@+id/layoutResultsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSceneCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5 Scene Ditemukan"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnExportAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_accent"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="Export Semua"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Daftar Kartu Scene -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvScenes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
